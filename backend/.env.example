PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/futurepath?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
FRONTEND_URL=http://localhost:5173
USE_MEMORY_DB_FALLBACK=true

# Supabase (Secondary Database Connection)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional

